# ---------------------------------------------------------------------------
# kube-wl-ai backend — example environment file.
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=kube-wl-ai
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
API_V1_PREFIX=/api/v1
# Comma-separated. Empty in development falls back to localhost:5173/8080.
CORS_ORIGINS=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------------
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://wl:wl@postgres:5432/kube_wl_ai
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Authentication ----------------------------------------------------------
# Comma-separated, from: local, ldap, oidc
AUTH_PROVIDERS=local

# Local break-glass account (always available; disable in production if unused)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=replace-me

# JWT — generate with:  openssl genrsa -out jwt-private.pem 4096
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=kube-wl-ai
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# FreeIPA / LDAP
LDAP_URI=ldaps://ipa.example.edu
LDAP_BASE_DN=dc=example,dc=edu
LDAP_USER_DN_TEMPLATE=uid={username},cn=users,cn=accounts,{base_dn}
LDAP_GROUP_BASE_DN=cn=groups,cn=accounts,{base_dn}
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_CERT=
# FreeIPA group whose members receive the read-only observer role
LDAP_OBSERVER_GROUP=

# OIDC (reserved)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Kubernetes --------------------------------------------------------------
K8S_IN_CLUSTER=false
# No real cluster is contacted unless one of these is set.
K8S_ENABLED=false
KUBECONFIG=
K8S_MANAGED_LABEL=wl-managed
K8S_NAMESPACE_PREFIX=wl-

# --- Harbor ------------------------------------------------------------------
HARBOR_URL=
HARBOR_ROBOT_NAME=
HARBOR_ROBOT_SECRET=

# --- Monitoring (existing cluster-side services) -----------------------------
PROMETHEUS_URL=
GRAFANA_URL=
GRAFANA_DATASOURCE_UID=

# --- SSH ---------------------------------------------------------------------
SSH_MODE=nodeport
SSH_NODEPORT_RANGE=30000-32767

# --- Storage -----------------------------------------------------------------
STORAGE_CLASS_HOME=
STORAGE_CLASS_DATA=
STORAGE_CLASS_SHARE=
