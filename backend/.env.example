# ---------------------------------------------------------------------------
# kube-wl-ai backend — example environment file.
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=kube-wl-ai
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
API_V1_PREFIX=/api/v1
# Comma-separated. Empty in development falls back to localhost:5173/8080.
CORS_ORIGINS=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------------
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://wl:wl@postgres:5432/kube_wl_ai
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# 镜像目录刷新间隔（秒）。默认 86400 = 每天一次。
# 这是镜像从「推送到 Harbor」变成「选择器里可见」的唯一自动途径；
# 小集群可以调到 3600（每小时）甚至更低。
IMAGE_SYNC_INTERVAL_SECONDS=86400

# --- Authentication ----------------------------------------------------------
# Comma-separated, from: local, ldap, oidc
# 逗号分隔，按顺序尝试。local 放最前 = 应急后门：
# 目录不可达时会让整条链 503，只有 local 排在前面的本地管理员仍能登录。
# 详见 deploy/ldap/README.md §4.1
AUTH_PROVIDERS=local

# Local break-glass account (always available; disable in production if unused)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=replace-me

# JWT — generate with:  openssl genrsa -out jwt-private.pem 4096
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=kube-wl-ai
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# FreeIPA / LDAP
LDAP_URI=ldaps://ipa.example.edu
LDAP_BASE_DN=dc=example,dc=edu
LDAP_USER_DN_TEMPLATE=uid={username},cn=users,cn=accounts,{base_dn}
LDAP_GROUP_BASE_DN=cn=groups,cn=accounts,{base_dn}
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_CERT=
# FreeIPA group whose members receive the read-only observer role
LDAP_OBSERVER_GROUP=

# OIDC (reserved)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Kubernetes --------------------------------------------------------------
K8S_IN_CLUSTER=false
# No real cluster is contacted unless one of these is set.
K8S_ENABLED=false
KUBECONFIG=
K8S_MANAGED_LABEL=wl-managed
K8S_NAMESPACE_PREFIX=wl-

# --- Harbor ------------------------------------------------------------------
HARBOR_URL=
HARBOR_ROBOT_NAME=
HARBOR_ROBOT_SECRET=

# --- Monitoring (existing cluster-side services) -----------------------------
PROMETHEUS_URL=
GRAFANA_URL=
GRAFANA_DATASOURCE_UID=

# --- SSH ---------------------------------------------------------------------
SSH_MODE=nodeport
SSH_NODEPORT_RANGE=30000-32767

# --- Storage -----------------------------------------------------------------
# Root the managed volumes are carved out of, on the node that backs them.
#     {root}/{group}/{username}   用户存储卷
#     {root}/{group}/{dir_name}   组共享卷
#     {root}/{group}              组本级卷
#     {root}/_global/{name}       全局共享卷
# The layout is an installation-wide decision, not a tenant's, so this is set
# here rather than per volume. Registering a volume is enough to make its
# directory usable: the PV is hostPath with type DirectoryOrCreate, so the
# kubelet materialises a missing directory on first mount. That is a deliberate
# convenience with a sharp edge — a mistyped registered path also succeeds, and
# the container then starts with an empty directory instead of failing. Point
# this at the GPFS/Lustre mount when that phase lands; existing volumes are not
# moved.
STORAGE_ROOT=/storage/kube-wl
# Reserved prefix for global shares, so a global share cannot be named after a
# group and land on that group's directory.
STORAGE_GLOBAL_SEGMENT=_global

# Scratch disks for instances and tasks. Unrelated to the managed volumes above:
# these are per-workload, dynamically provisioned, and deleted with the workload.
# Managed volumes are static hostPath PVs and do not need a StorageClass.
STORAGE_CLASS_HOME=
STORAGE_CLASS_DATA=
STORAGE_CLASS_SHARE=
