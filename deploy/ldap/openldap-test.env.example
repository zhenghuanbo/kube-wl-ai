# kube-wl-ai —— 针对本机 OpenLDAP 测试环境的配置
#
# 已对着真实目录验证通过（两个用户、两个组、登录 + 角色 + 组成员）。
# 目录：dc=hpc,dc=westlake，OpenLDAP osixia 镜像，NodePort 30389。

# --- 基础 ---------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://kube_wl_ai:CHANGE_ME@127.0.0.1:5432/kube_wl_ai
SECRET_KEY=replace-with-a-long-random-string-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173

# --- 认证 ---------------------------------------------------------------------
# local 放最前 = 目录不可达时本地管理员仍能登录。
# 反过来写 ldap,local 的话，LDAP 抛错会直接 503，轮不到 local。
AUTH_PROVIDERS=local,ldap
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=smoke-test-password-123

# --- LDAP / OpenLDAP ----------------------------------------------------------
# 明文 389/30389，不需要 LDAP_CA_CERT。
# 平台跑在集群内时也可以用 openldap-service.openldap.svc.cluster.local:389
LDAP_URI=ldap://10.28.0.194:30389
LDAP_BASE_DN=dc=hpc,dc=westlake

# 关键：OpenLDAP 的用户在 ou=Users，且 RDN 必须是 uid=（见下方说明）
LDAP_USER_DN_TEMPLATE=uid={username},ou=Users,{base_dn}

# OpenLDAP 的组在 ou=Groups（FreeIPA 是 cn=groups,cn=accounts）
LDAP_GROUP_BASE_DN=ou=Groups,{base_dn}

# 读属性用服务账号。测试环境直接用 admin，但生产环境请建只读账号：
#   cn=svc-kube-wl-ai,ou=Users,dc=hpc,dc=westlake
LDAP_BIND_DN=cn=admin,dc=hpc,dc=westlake
LDAP_BIND_PASSWORD=admin

# 该组成员在「首次登录」时获得只读 observer 角色。
# 注意：只在首次创建账号时判定，之后加/移都不会变（详见 deploy/ldap/README.md §10）
LDAP_OBSERVER_GROUP=hpc-test

# --- 集群（测试阶段可以先关掉，元数据功能不受影响）---------------------------
K8S_ENABLED=false
KUBECONFIG=
