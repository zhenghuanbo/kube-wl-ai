# Frontend environment. Only VITE_-prefixed variables reach the browser.
# Copy to `.env.local` for local overrides.

# Backend API base path. Keep it relative so production stays same-origin
# behind nginx (no hardcoded host:port anywhere in the app — see plan §10.4).
VITE_API_BASE_URL=/api/v1

# Reverse-proxied Grafana path, used by the monitoring centre (Phase 7).
VITE_GRAFANA_PATH=/grafana

# Dev-server proxy target only (vite.config.ts). Not used in builds.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# --- Dev-server remote access (vite.config.ts only; never used in builds) -----
# All three are off by default: `npm run dev` binds loopback, so running it on a
# shared machine does not silently publish a dev server.

# Bind address. Set to 0.0.0.0 to reach the dev server from another host.
# Only this one port needs to be reachable — /api and /ws are proxied by the dev
# server itself, so the backend stays on loopback and no CORS entry is needed.
# VITE_DEV_HOST=0.0.0.0

# Hostnames to accept, for access through something that is not an IP address
# (a tunnel, an ingress, a cloud dev proxy). Bare IPs and `localhost` already
# work; an unlisted hostname gets a 403 that looks like a broken app rather than
# a dev-server policy. Comma-separated.
# VITE_ALLOWED_HOSTS=dev.example.edu,mybox.internal

# HMR endpoint, only needed when a terminating proxy sits in front (HTTPS
# tunnel). Without these the page loads but never hot-reloads.
# VITE_HMR_HOST=dev.example.edu
# VITE_HMR_CLIENT_PORT=443
# VITE_HMR_PROTOCOL=wss
